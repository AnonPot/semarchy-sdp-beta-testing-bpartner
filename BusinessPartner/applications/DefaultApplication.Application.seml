_package: applications
_type: Application
_name: DefaultApplication
label: Default Application
visibility: VISIBLE
applicationTitle: Default Application
avatarImageUrl: images://default-data-app-icon.svg
logoUrl: images://default/semarchy-logo-navy.svg
coverImageUrl: images://default/cover.png
favIcon: images://default/dm-favicon.svg
sortStrategy: POSITION
historyBrowsingEnabled: false
historyBrowsingRequiredRole: ""
defaultAction: applications.DefaultApplication.Root
documentationConfig:
  documentation: ""
globalSearchConfig:
  displaySearchForDropdown: true
  sortBusinessViewsAlphabetically: true
navDrawer:
  - _type: FolderNavGroup
    _name: RootFolder
    dividerVisible: false
    labelVisible: false
    linkedFolder: applications.DefaultApplication.Root
  - _type: FolderNavGroup
    _name: AddressFolder
    dividerVisible: true
    labelVisible: true
    linkedFolder: applications.DefaultApplication.Root.AddressFolder
rootFolder:
  _type: FolderAction
  _name: Root
  label: Root Folder
  image: images://mdi/folder.svg
  imageAlign: MIDDLE_CENTER
  imageMode: FIT
  appActions:
    - _type: GlobalSearchAction
      _name: GlobalSearch
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
    - _type: MyTasksAction
      _name: MyTasks
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      badgeVisible: false
    - _type: BrowseEntitiesFolderAction
      _name: Entities
      lineageEnabled: true
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
    - _type: FolderAction
      _name: AddressFolder
      label: Address
      image: images://mdi/book.svg
      imageAlign: MIDDLE_CENTER
      imageMode: FIT
      appActions:
        - _type: BrowseBusinessViewAction
          _name: Address
          label: Address
          image: images://mdi/book.svg
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          businessView: entities.Address.business_views.AddressBusinessView
          nbRecordsBadgeVisible: true
        - _type: BrowseBusinessViewAction
          _name: AddressHierarchical
          label: Address Hierarchical
          image: images://mdi/book.svg
          imageAlign: MIDDLE_CENTER
          imageMode: FIT
          businessView: entities.Address.business_views.AddressHierarchical
          nbRecordsBadgeVisible: true
