_package: entities.BusinessPartner.action_sets
_type: ActionSet
_name: BusinessPartnerActionSet
entity: entities.BusinessPartner.BusinessPartner
label: Business Partner Action Set
defaultActionSet: true
actions:
  - _type: CreateAction
    _name: CreateAuthorBusinessPartners
    label: Create
    useCustomLabel: true
    stepper: entities.BusinessPartner.steppers.AuthorBusinessPartners
    createMultiple: false
